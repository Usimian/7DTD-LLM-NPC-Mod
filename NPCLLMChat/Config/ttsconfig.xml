<?xml version="1.0" encoding="UTF-8"?>
<!--
    NPC LLM Chat - Text-to-Speech Configuration

    Windows and Linux both use the Piper TTS server. Run setup_servers.bat
    (or setup_servers.sh) once and the game starts it for you.

    There is no built-in-Windows-voice option. The game embeds a Mono runtime
    with no System.Speech in it, so Windows SAPI cannot be reached from inside
    the mod on any version of Windows. Earlier notes here promised otherwise.
-->
<TTSConfig>
    <!-- TTS Server Configuration -->
    <Server>
        <!--
            TTS Provider:
            - Auto  : the Piper server (recommended - this is what it picks)
            - Piper : the same thing, stated outright
        -->
        <Provider>Auto</Provider>

        <!-- Enable or disable TTS entirely -->
        <Enabled>true</Enabled>

        <!--
            Piper TTS server endpoint (used on Linux or when Provider=Piper)
            Start server: python piper_server.py -port 5050
        -->
        <Endpoint>http://localhost:5050/synthesize</Endpoint>

        <!-- Request timeout in seconds -->
        <TimeoutSeconds>10</TimeoutSeconds>
    </Server>

    <!-- Audio Playback Settings -->
    <Audio>
        <!-- Master volume (0.0 to 1.0) -->
        <Volume>0.8</Volume>

        <!-- 3D spatial audio: distance in meters -->
        <MaxDistance>20</MaxDistance>
        <MinDistance>2</MinDistance>

        <!-- Speech rate (1.0 = normal, 1.2 = faster, 0.8 = slower) -->
        <SpeechRate>1.0</SpeechRate>
    </Audio>

    <!--
        Voice Configuration
        
        On Windows: These map to voice gender (names containing "amy"/"lessac" = female, "ryan" = male)
        On Linux: Use Piper voice IDs (download from huggingface.co/rhasspy/piper-voices)
    -->
    <!--
        Pronunciation fixes

        Piper works out how to say a word from its spelling, and place names
        beat it: "Tucson" comes out "TUCK-sun". Respell the word the way it
        sounds and it says it properly. Only the audio is affected - the
        written line keeps the real spelling.

        say = the respelling to speak, the element text = the word to catch.
        Matching is whole-word and ignores case.
    -->
    <Pronunciations>
        <Word say="Tooson">Tucson</Word>
    </Pronunciations>

    <Voices>
        <DefaultVoice>en_US-lessac-medium</DefaultVoice>
        <TraderVoice>en_US-ryan-medium</TraderVoice>
        <CompanionVoice>en_US-amy-medium</CompanionVoice>
        <BanditVoice>en_US-ryan-medium</BanditVoice>
    </Voices>
</TTSConfig>
