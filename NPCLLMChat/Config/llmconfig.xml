<?xml version="1.0" encoding="UTF-8"?>
<!--
    NPC LLM Chat Configuration

    Optimized for RTX 6000 Pro (48GB VRAM)
    You can run larger models like llama3:70b or mixtral for better roleplay!
-->
<LLMConfig>
    <!-- LLM Server Configuration -->
    <Server>
        <!--
            Endpoints:
            - Ollama: http://localhost:11434/api/generate
            - LM Studio: http://localhost:1234/v1/chat/completions
            - Text-generation-webui: http://localhost:5000/v1/chat/completions
        -->
        <Endpoint>https://api.groq.com/openai/v1/chat/completions</Endpoint>

        <!--
            Recommended models for RTX 6000 Pro (48GB VRAM):

            Fast responses (< 1 second):
            - gemma2:9b        - Fast, good quality
            - llama3:8b        - Great balance
            - mistral:7b       - Fast and capable

            Better roleplay (1-2 seconds):
            - llama3:70b       - Excellent roleplay, fits in VRAM!
            - mixtral:8x7b     - Great multi-character voice
            - command-r:35b    - Good conversation

            Best quality (2-4 seconds):
            - llama3:70b-instruct-q8_0  - Best quality
            - qwen2:72b        - Excellent Chinese/English

            For your GPU, llama3:70b gives the best roleplay quality
            while still maintaining reasonable response times.
        -->
        <Model>llama-3.3-70b-versatile</Model>

        <!--
            CLOUD / HOSTED MODELS (no local GPU needed)
            ==========================================
            Point Endpoint at any OpenAI-compatible /v1/chat/completions URL, set Model to
            that provider's model id, and supply a key. Everything else in this mod works
            unchanged - conversation, memory summaries and combat lines all use the same path.

            Set the key with the NPCLLM_API_KEY environment variable rather than in this file,
            so it is never shared or committed:
                Linux   export NPCLLM_API_KEY=sk-...      (before launching Steam)
                Windows setx NPCLLM_API_KEY sk-...
            A desktop-launched Steam does not inherit shell exports, so the easiest route on
            Linux is a key file instead - the mod reads it automatically:
                mkdir -p ~/.config/npcllm && chmod 700 ~/.config/npcllm
                printf '%s' 'gsk_your_key_here' > ~/.config/npcllm/api_key
                chmod 600 ~/.config/npcllm/api_key
            Order of precedence: NPCLLM_API_KEY, then that file, then <ApiKey> below.
            Do NOT put a key in <ApiKey> if you track this file in git.

            Providers with a free tier at time of writing (verify current terms and limits):
              Google Gemini    https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
                               Model e.g. gemini-2.0-flash
              Groq             https://api.groq.com/openai/v1/chat/completions
                               Model llama-3.3-70b-versatile - TESTED, best of the three:
                               0.4-1.4s replies, stays in character, respects short answers.
                               Avoid qwen/qwen3.6-27b there: it returns its <think> scratchpad
                               as the reply. gpt-oss-120b works but rate limits sooner.
              OpenRouter       https://openrouter.ai/api/v1/chat/completions
                               Model e.g. one of the ":free" ids
              Mistral          https://api.mistral.ai/v1/chat/completions
              Cerebras         https://api.cerebras.ai/v1/chat/completions

            A companion turn is roughly 1-2k tokens of context, so conversation is cheap even
            on paid tiers; free tiers are usually rate limited per minute rather than per day.
            Note TTS (Piper) and STT (Whisper) still run locally - both are fine on CPU.

            Reasoning ("thinking") models: the "think": false switch used for local Ollama does
            not exist on the OpenAI-compatible API, and hidden reasoning is billed against
            max_tokens - too small a budget returns an EMPTY reply. The mod therefore never
            sends less than 512 there. Prefer a non-reasoning model for a companion anyway:
            it is cheaper and answers in well under a second.
        -->
        <ApiKey></ApiKey>

        <!-- Timeout - can be shorter with fast GPU -->
        <TimeoutSeconds>15</TimeoutSeconds>

        <!--
            Token limits - higher = longer responses
            RTX 6000 Pro can handle large context easily
        -->
        <MaxTokens>400</MaxTokens>

        <!--
            Temperature - controls creativity/randomness
            0.7-0.9 is good for roleplay, lower for factual responses
        -->
        <Temperature>0.8</Temperature>

        <!--
            GPU Layers - Ollama auto-detects, but you can force full GPU offload
            For 70B model on 48GB: use 80+ layers
        -->
        <NumGPULayers>83</NumGPULayers>

        <!--
            Context window - how much conversation history to consider
            Larger = better memory but more VRAM

            Her world state is not small: every labelled storage crate is its own entry with
            its full contents, and that alone runs to ~2700 tokens at a well-sorted base and
            grows by 200-400 with each new crate. 32768 leaves room for that plus the
            conversation; drop it back to 16384 if you are running a smaller GPU and keep an
            eye on whether she starts losing the thread of a conversation.
        -->
        <NumCtx>32768</NumCtx>
    </Server>

    <!-- NPC Personality Defaults -->
    <Personality>
        <!--
            Base system prompt for all NPCs.
            Individual NPCs can have additional personality traits.
        -->
        <SystemPrompt>You are a survivor in a post-apocalyptic zombie wasteland set in Arizona. The year is approximately 7 years after the outbreak. You speak naturally with personality, showing the weariness of survival but also moments of hope or dark humor. Let the reply fit what was said, the way real speech does: a yes-or-no question gets "Yep" or "Not a chance, hon" and nothing more, a quick exchange gets a line or a quip, and only something that genuinely needs explaining - a story, a plan, a warning - earns three or four sentences. When the honest answer is yes or no, say just that and STOP - no tacked-on observation, no follow-up question, no helpful extra. Never pad a small answer to make it a paragraph, and never answer at the same length twice in a row out of habit. Stay deeply in-character. Never break character or mention being an AI. React to the player's tone and build rapport over multiple exchanges. You have your own goals, fears, and opinions.</SystemPrompt>

        <!--
            Context Memory - number of previous exchanges to remember
            Higher = better continuity but uses more tokens
            With 48GB VRAM, you can afford more memory
        -->
        <ContextMemory>40</ContextMemory>
    </Personality>

    <!-- Response Handling -->
    <Response>
        <!--
            Typing indicator - shows "..." while thinking
            Disable for faster feel with powerful GPU
        -->
        <ShowTypingIndicator>false</ShowTypingIndicator>

        <!--
            Typing delay per character (milliseconds)
            0 = instant display, 30-50 = typewriter effect
            With fast GPU, you may prefer instant
        -->
        <TypingDelayMs>0</TypingDelayMs>

    </Response>

    <!-- Action System Settings -->
    <Actions>
        <!--
            Enable NPC actions (follow, trade, guard, etc.)
        -->
        <Enabled>true</Enabled>

        <!--
            Require explicit consent for dangerous actions
        -->
        <RequireConfirmation>true</RequireConfirmation>

        <!--
            Default follow distance in meters
        -->
        <FollowDistance>3.0</FollowDistance>

        <!--
            Default guard radius in meters
        -->
        <GuardRadius>10.0</GuardRadius>
    </Actions>
</LLMConfig>
